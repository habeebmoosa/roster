# ─────────────────────────────────────────────────────────────
# Roster environment configuration
# Copy to `.env` and adjust. `.env` is git-ignored.
# ─────────────────────────────────────────────────────────────

# Database — ANY PostgreSQL with the pgvector extension available.
# The database is fully provider-agnostic: point these at local Docker,
# a self-hosted Postgres on EC2, Supabase, Neon, RDS, etc.
#
# The local Docker default (see docker/docker-compose.yml). Host port is 5433
# to avoid clashing with any Postgres already running locally on 5432.
DATABASE_URL="postgresql://roster:roster@localhost:5433/roster?schema=public"

# Direct (non-pooled) connection used for migrations. For serverless/pooled
# targets (Neon, Supabase pooler, PgBouncer) set this to the direct URL.
# For local Docker it is identical to DATABASE_URL.
DIRECT_URL="postgresql://roster:roster@localhost:5433/roster?schema=public"

# development | test | production
NODE_ENV="development"

# ── Auth.js ──────────────────────────────────────────────────
# Session secret used to sign/encrypt the JWT. Generate with:
#   openssl rand -base64 33
AUTH_SECRET=""

# Optional: canonical app URL. Auth.js infers it in dev; set in production
# (e.g. https://roster.example.com).
# AUTH_URL=""

# ── Google OAuth ─────────────────────────────────────────────
# Create an OAuth 2.0 Client (type: Web application) in the Google Cloud
# console. Authorized redirect URI (local dev):
#   http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── BYOK vault ───────────────────────────────────────────────
# Server-side secret used to encrypt stored provider keys (AES-256-GCM).
# Must decode to exactly 32 bytes. Generate with:
#   openssl rand -base64 32
ENCRYPTION_KEY=""
