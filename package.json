{
  "name": "roster",
  "version": "0.1.2",
  "private": true,
  "description": "Roster — hireable, specialized AI employees that perform like experts on any LLM you bring.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev -p 3005",
    "build": "next build",
    "start": "next start -p 3005",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "db:up": "docker compose -f docker/docker-compose.yml up -d",
    "db:down": "docker compose -f docker/docker-compose.yml down",
    "db:wait": "docker compose -f docker/docker-compose.yml exec -T postgres pg_isready -U roster -d roster",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:seed": "prisma db seed",
    "eval": "tsx scripts/eval.ts",
    "eval:gate": "tsx scripts/eval.ts --gate",
    "ingest": "tsx scripts/ingest-knowledge.ts",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.16",
    "@ai-sdk/google": "^4.0.18",
    "@ai-sdk/openai": "^4.0.16",
    "@ai-sdk/openai-compatible": "^3.0.12",
    "@auth/prisma-adapter": "^2.11.2",
    "@prisma/client": "^6",
    "ai": "^7.0.31",
    "gpt-tokenizer": "^3.4.0",
    "next": "^15",
    "next-auth": "^5.0.0-beta.31",
    "react": "^19",
    "react-dom": "^19",
    "yaml": "^2.9.0",
    "zod": "^3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4",
    "@vitest/coverage-v8": "^3.2.7",
    "dotenv": "^16",
    "eslint": "^9",
    "eslint-config-next": "^15",
    "jsdom": "^29.1.1",
    "postcss": "^8",
    "prettier": "^3",
    "prettier-plugin-tailwindcss": "^0.6",
    "prisma": "^6",
    "tailwindcss": "^4",
    "tsx": "^4",
    "typescript": "^5",
    "vite-tsconfig-paths": "^5",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "esbuild": "^0.25.0",
    "sharp": "^0.35.0"
  }
}
