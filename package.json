{
  "name": "roster",
  "version": "0.1.9",
  "private": true,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/habeebmoosa/roster.git"
  },
  "description": "Roster — hireable, specialized AI employees that perform like experts on any LLM you bring.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev -p 3005",
    "build": "next build",
    "start": "next start -p 3005",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "db:up": "docker compose -f docker/docker-compose.yml up -d",
    "db:down": "docker compose -f docker/docker-compose.yml down",
    "db:wait": "docker compose -f docker/docker-compose.yml exec -T postgres pg_isready -U roster -d roster",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:seed": "prisma db seed",
    "eval": "tsx scripts/eval.ts",
    "eval:gate": "tsx scripts/eval.ts --gate",
    "ingest": "tsx scripts/ingest-knowledge.ts",
    "models:sync": "tsx scripts/sync-model-catalog.ts",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@ai-sdk/amazon-bedrock": "^5.0.39",
    "@ai-sdk/anthropic": "^4.0.16",
    "@ai-sdk/azure": "^4.0.27",
    "@ai-sdk/cerebras": "^3.0.19",
    "@ai-sdk/cohere": "^4.0.17",
    "@ai-sdk/deepinfra": "^3.0.19",
    "@ai-sdk/fireworks": "^3.0.20",
    "@ai-sdk/google": "^4.0.18",
    "@ai-sdk/google-vertex": "^5.0.37",
    "@ai-sdk/huggingface": "^2.0.19",
    "@ai-sdk/openai": "^4.0.16",
    "@ai-sdk/openai-compatible": "^3.0.12",
    "@ai-sdk/perplexity": "^4.0.19",
    "@auth/prisma-adapter": "^2.11.2",
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "@prisma/client": "^6",
    "@sentry/nextjs": "^10.69.0",
    "@upstash/redis": "^1.38.0",
    "ai": "^7.0.31",
    "gpt-tokenizer": "^3.4.0",
    "lucide-react": "^1.28.0",
    "luxon": "^3.7.2",
    "mammoth": "^1.12.0",
    "marked": "^18.0.7",
    "next": "^15",
    "next-auth": "^5.0.0-beta.31",
    "pdf-parse": "^2.4.5",
    "react": "^19",
    "react-dom": "^19",
    "react-markdown": "^10.1.0",
    "turndown": "^7.2.4",
    "yaml": "^2.9.0",
    "zod": "^4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@lobehub/icons-static-svg": "^1.94.0",
    "@playwright/test": "^1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/luxon": "^3.7.2",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^4",
    "@vitest/coverage-v8": "^3.2.7",
    "dotenv": "^16",
    "eslint": "^9",
    "eslint-config-next": "^15",
    "jsdom": "^29.1.1",
    "jszip": "^3.10.1",
    "nock": "^14.0.17",
    "postcss": "^8",
    "prettier": "^3",
    "prettier-plugin-tailwindcss": "^0.6",
    "prisma": "^6",
    "simple-icons": "^16.28.0",
    "tailwindcss": "^4",
    "tsx": "^4",
    "typescript": "^5",
    "vite-tsconfig-paths": "^5",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "esbuild": "^0.25.0",
    "sharp": "^0.35.0"
  }
}
